{
  "name": "ekiti-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first Ekiti civic intelligence platform",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "tsc --noEmit",
    "test:all": "npm run check && npm test",
    "test:postgis": "node --experimental-strip-types --test tests/postgis.mjs && node --experimental-strip-types --test tests/evidence-postgis.mjs",
    "build": "vite build",
    "dev": "wrangler dev",
    "test:browser": "playwright test",
    "staging:prepare": "node scripts/prepare-staging.mjs",
    "staging:check": "npm run build && node scripts/prepare-staging.mjs --dry-run && wrangler deploy --config wrangler.dry-run.local.json --dry-run --outdir .wrangler/staging-check"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.7",
    "wrangler": "^4.159.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  },
  "dependencies": {
    "maplibre-gl": "^6.17.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0"
  }
}
