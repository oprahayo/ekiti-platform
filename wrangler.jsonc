{
  "name": "ekiti-location",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "run_worker_first": ["/api/*"] },
  // Replace this local development ID with the restricted Hyperdrive binding before staging.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000" }],
  "ratelimits": [
    { "name": "LOCATION_LIMIT", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
  ],
  "observability": { "enabled": false },
}
